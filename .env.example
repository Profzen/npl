# Exemple de configuration Audit AI
# Copier ce fichier en .env et renseigner les valeurs selon l'environnement d'integration.

APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_USER=
ORACLE_PASSWORD=CHANGER_CETTE_VALEUR
ORACLE_AUDIT_TABLE=SMART2DSECU.UNIFIED_AUDIT_DATA

SQLITE_PATH=./data/auditai.db

NLP_MODEL_PATH=
NLP_LORA_PATH=
SYNTHESIS_MODEL_PATH=

CORS_ORIGINS=http://localhost:3000
